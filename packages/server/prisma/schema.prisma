generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  devices         Device[]
  timeRecords     TimeRecord[]
  diaries         DiaryEntry[]
  worklistItems   WorklistItem[]
  memoItems       MemoItem[]
  workYearDigests WorkYearDigest[]
  aiConversations AiConversation[]
  aiSkills        AiSkill[]
  refreshTokens           RefreshToken[]
  browserCaptures         BrowserPageCapture[]
  extensionUploadTokens   ExtensionUploadToken[]
}

/// Chrome 扩展用的「上传密钥」：长期有效，仅存哈希；吊销后记 revokedAt。
model ExtensionUploadToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  label       String    @default("")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Chrome 扩展「监听页面」抓取后经 AI 摘要，提交到服务端供移动端查看。
model BrowserPageCapture {
  id          String   @id @default(uuid())
  userId      String
  url         String   @db.Text
  title       String   @default("")
  pageSnippet String   @db.Text
  aiSummary   String   @db.Text
  capturedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id         String    @id
  userId     String
  platform   String
  name       String
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TimeRecord {
  id             String    @id
  userId         String
  date           String
  appKey         String
  appName        String
  durationMs     Int
  updatedAt      DateTime
  deletedAt      DateTime?
  clientDeviceId String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, appKey])
  @@index([userId, updatedAt])
}

model DiaryEntry {
  id             String    @id
  userId         String
  date           String
  content        String    @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  deletedAt      DateTime?
  clientDeviceId String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model WorklistItem {
  id                  String    @id
  userId              String
  listDate            String
  quadrant            String    @default("q2")
  name                String
  icon                String
  note                String    @db.Text
  reminderAt          DateTime?
  estimateDoneAt      DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  deletedAt           DateTime?
  reminderNotified    Boolean   @default(false)
  completionResult    String    @default("")
  confirmSnoozeUntil  DateTime?
  clientDeviceId      String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, listDate])
}

model MemoItem {
  id               String    @id
  userId           String
  name             String
  icon             String
  content          String    @db.Text
  reminderAt       DateTime?
  createdAt        DateTime
  updatedAt        DateTime
  deletedAt        DateTime?
  reminderNotified Boolean   @default(false)
  clientDeviceId   String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model WorkYearDigest {
  id             String    @id
  userId         String
  year           Int
  payloadJson    String    @db.Text
  updatedAt      DateTime
  deletedAt      DateTime?
  clientDeviceId String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId, updatedAt])
}

model AiConversation {
  id             String    @id
  userId         String
  title          String
  pet            String?
  skillId        String?
  messagesJson   String    @db.Text
  updatedAt      DateTime
  deletedAt      DateTime?
  clientDeviceId String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model AiSkill {
  id             String    @id
  userId         String
  name           String
  promptTemplate String    @db.Text
  configJson     String    @db.Text
  updatedAt      DateTime
  deletedAt      DateTime?
  clientDeviceId String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model WorkQuote {
  id        String   @id @default(uuid())
  content   String   @db.Text
  author    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
