{
  "name": "time-manger-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "desktop:dev": "pnpm --filter @time-manger/desktop electron-start",
    "desktop:dev:debug": "pnpm --filter @time-manger/desktop electron-start-debug-log",
    "desktop:devtool":"pnpm --filter @time-manger/desktop react-start --open",
    "desktop:build": "pnpm --filter @time-manger/desktop electron-build",
    "desktop:ico": "pnpm --filter @time-manger/desktop run icon:ico",
    "server:dev": "pnpm --filter @time-manger/server dev",
    "server:dev:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/server-dev-clean.ps1",
    "db:up": "docker compose -f packages/server/docker-compose.yml up -d postgres",
    "db:migrate": "pnpm --filter @time-manger/server run db:migrate:deploy",
    "db:prepare": "pnpm run db:up && pnpm run db:migrate && pnpm --filter @time-manger/server run prisma:generate",
    "shared:build": "pnpm --filter @time-manger/shared build",
    "mobile:start": "pnpm --filter @time-manger/mobile start",
    "mobile:start:tunnel": "pnpm --filter @time-manger/mobile run start:tunnel",
    "mobile:build:android": "pnpm --filter @time-manger/mobile run build:android",
    "mobile:build:android:apk": "pnpm --filter @time-manger/mobile run build:android:apk",
    "mobile:build:ios": "pnpm --filter @time-manger/mobile run build:ios",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "prisma:studio": "pnpm --filter @time-manger/server run studio"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
